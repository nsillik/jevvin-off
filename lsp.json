{
  "servers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "fileTypes": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
      ],
      "rootMarkers": [
        "tsconfig.json",
        "package.json"
      ]
    }
  }
}
